<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Movies | MovieHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("partials/navbar") %>

    <main class="container py-5">
        <div class="section-header">
            <div>
                <h2 class="section-title">Recommended Movies</h2>
                <p class="text-muted mb-0">Browse through our curated list of must-watch cinema.</p>
            </div>
            <% if(locals.user && locals.user.role === "ADMIN"){ %>
                <a href="/movies/add" class="btn btn-primary-bms">
                    + Add New Movie
                </a>
            <% } %>
        </div>

        <% if(locals.error){  %>
            <div class="alert alert-danger mb-4 border-0 shadow-sm">
                <%= error %>
            </div>
        <% } %>

        <% if(movies.length === 0){ %>
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <div style="font-size: 3rem; color: #ddd; margin-bottom: 1rem;">🎞️</div>
                <h4 class="fw-bold">No Movies Available</h4>
                <p class="text-muted">Stay tuned! We're adding new blockbusters very soon.</p>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                <% movies.forEach(movie => { %>
                    <div class="col">
                        <a href="/movies/<%= movie.id %>" class="text-decoration-none">
                            <div class="movie-card shadow-sm">
                                <div class="movie-poster-container">
                                    <img src="<%= movie.posterurl %>" alt="<%= movie.title %>">
                                </div>
                                <div class="movie-info">
                                    <h5 class="movie-title text-dark"><%= movie.title %></h5>
                                    <div class="movie-meta d-flex justify-content-between align-items-center">
                                        <span><%= movie.genre %></span>
                                        <span class="badge-bms"><%= movie.language %></span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <footer class="py-5">
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 MovieHub. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
